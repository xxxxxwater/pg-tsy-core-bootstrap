{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pg://contracts/signal.v1.json",
  "title": "PG Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "alpha_id",
    "asset",
    "venue",
    "score",
    "confidence",
    "horizon_ms",
    "created_at_ns",
    "expires_at_ns"
  ],
  "properties": {
    "schema_version": {"const": "signal.v1"},
    "signal_id": {"type": "string", "minLength": 1},
    "alpha_id": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "venue": {"enum": ["BINANCE_PM", "HYPERLIQUID", "IBKR"]},
    "score": {"type": "number", "minimum": -1.0, "maximum": 1.0},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "horizon_ms": {"type": "integer", "minimum": 1},
    "created_at_ns": {"type": "integer", "minimum": 0},
    "expires_at_ns": {"type": "integer", "minimum": 0},
    "model_version": {"type": ["string", "null"]},
    "feature_set": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
