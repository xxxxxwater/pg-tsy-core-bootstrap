# Existing InstaBox paths (adapt only if your deployment differs)
RSS_DATA_DIR=/data/home/puregamma-event-collector/data
# Dedicated 0600 file holding ONLY Coinbase credentials:
#   COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
#   COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# Do NOT point this at the shared TSY .env (Hyperliquid/Binance/Telegram secrets).
# Any non-COINBASE_* line in it is ignored by the worker.
COINBASE_ENV_FILE=./secrets/coinbase.env
# Coinbase LIVE ONLY (no paper code). Remains disarmed until explicit limits.
# Arming and limits are read only from here (Compose environment), never from the secret file.
PG_LIVE_TRADING=false
COINBASE_PORTFOLIO_ID=
LIVE_ORDER_USD=0
LIVE_MAX_ORDER_USD=0
LIVE_MAX_DAILY_USD=0
