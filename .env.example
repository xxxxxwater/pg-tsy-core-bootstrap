# Safe default: the Docker quick-start runs SHADOW only and never sends orders.
PG_ENV=dev
PG_INSTANCE_ID=pg-core-1
PG_RUN_MODE=shadow
PG_LIVE_TRADING=false
PG_SHUTDOWN_POLICY=cancel_resting
PG_DATABASE_URL=postgresql://pgtsy:pgtsy@postgres:5432/pgtsy
PG_DATA_ROOT=/app/data
PG_STRATEGY_DIR=/app/strategies
PG_SIGNAL_TTL_MS=5000
PG_MAX_MARKET_STALENESS_MS=10000
PG_LEASE_TTL_SECONDS=15
PG_LEASE_KEY=pg-core:dev:shadow
PG_HEALTH_ADDR=0.0.0.0:8080
PG_HYPERLIQUID_NETWORK=mainnet
PG_MARKET_MAX_RECONNECTS=50
# Simulated venue behaviour for the shadow runtime. "rest" only acknowledges
# orders; "immediate" fills them so position/exit logic is observable before a
# real venue is wired. Neither sends a real order.
PG_SHADOW_FILL_MODE=rest
RUST_LOG=info

# Development Postgres used by docker-compose.yml.
POSTGRES_USER=pgtsy
POSTGRES_PASSWORD=pgtsy
POSTGRES_DB=pgtsy

# Never commit real credentials. The safe shadow quick-start does not need them.
BINANCE_API_KEY=
BINANCE_API_SECRET=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
# Interactive Brokers. Only read when an enabled strategy declares an IBKR
# instrument. Run the gateway with: docker compose --profile ibkr up -d
# Inside compose the gateway is a sibling service, so use ib-gateway:4002 there;
# use 127.0.0.1:4002 when pg-core runs directly on the host.
IBKR_GATEWAY_ADDR=127.0.0.1:4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=
IBKR_MARKET_DEPTH_ROWS=5
IBKR_DEFAULT_EXCHANGE=SMART
IBKR_DEFAULT_CURRENCY=USD

# IB Gateway container (docker compose --profile ibkr). Paper mode listens on
# API port 4002; live mode uses 4001, so change both values together.
IBKR_TWS_USERID=
IBKR_TWS_PASSWORD=
IBKR_TRADING_MODE=paper
IBKR_GATEWAY_API_PORT=4002
IBKR_GATEWAY_PORT=4002
IBKR_READ_ONLY_API=yes

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
