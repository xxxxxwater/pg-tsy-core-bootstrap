# Safe default: the Docker quick-start runs SHADOW only and never sends orders.
PG_ENV=dev
PG_INSTANCE_ID=pg-core-1
PG_RUN_MODE=shadow
PG_LIVE_TRADING=false
# Live defaults to false even when PG_RUN_MODE=live; /start or an explicitly
# enabled operator control should be used after startup reconciliation is clean.
PG_AUTO_START=false
PG_SHUTDOWN_POLICY=cancel_resting
PG_DATABASE_URL=postgresql://pgtsy:pgtsy@postgres:5432/pgtsy
PG_DATA_ROOT=/app/data
PG_STRATEGY_DIR=/app/strategies
PG_SIGNAL_TTL_MS=5000
PG_MAX_MARKET_STALENESS_MS=10000
PG_LEASE_TTL_SECONDS=15
PG_LEASE_KEY=pg-core:dev:shadow
PG_HEALTH_ADDR=0.0.0.0:8080
PG_MARKET_MAX_RECONNECTS=50
PG_RECONCILE_INTERVAL_MS=2000
RUST_LOG=info

# Simulated venue behaviour is read only by PG_RUN_MODE=shadow. Paper/live never
# construct ShadowExecutionAdapter and never fall back to this setting.
PG_SHADOW_FILL_MODE=rest

# Development Postgres used by docker-compose.yml. Production should use a
# dedicated password injected through the deployment secret mechanism.
POSTGRES_USER=pgtsy
POSTGRES_PASSWORD=pgtsy
POSTGRES_DB=pgtsy

# -----------------------------------------------------------------------------
# Hyperliquid real venue
# -----------------------------------------------------------------------------
# Main trading/master account that owns the positions and collateral.
HYPERLIQUID_ACCOUNT_ADDRESS=
# Preferred production signer: an authorized Hyperliquid API/Agent wallet.
# Never commit its private key. Either set the value in the process environment
# or point the *_FILE variable at a read-only Docker/Kubernetes secret mount.
HYPERLIQUID_AGENT_ADDRESS=
HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_AGENT_PRIVATE_KEY_FILE=
# Legacy compatibility only; new deployments should use the Agent key variables.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_PRIVATE_KEY_FILE=
# PG_RUN_MODE=paper is accepted for Hyperliquid only when this is testnet.
HYPERLIQUID_NETWORK=mainnet
PG_HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_MAX_MARKET_SLIPPAGE=0.005
# Reserved for an explicit vault/subaccount integration. Do not confuse this with
# the signer address or main account address.
HYPERLIQUID_VAULT_ADDRESS=

# -----------------------------------------------------------------------------
# Interactive Brokers via TWS / IB Gateway
# -----------------------------------------------------------------------------
# pg-core talks only to the Gateway socket. IBKR username/password stay at the
# gateway boundary and are never persisted by pg-core.
IBKR_GATEWAY_ADDR=127.0.0.1:4002
IBKR_CLIENT_ID=17
IBKR_EXECUTION_CLIENT_ID_BASE=117
IBKR_MARKETDATA_CLIENT_ID_BASE=1017
IBKR_ACCOUNT=
IBKR_MARKET_DEPTH_ROWS=5
IBKR_DEFAULT_EXCHANGE=SMART
IBKR_DEFAULT_CURRENCY=USD
IBKR_SUBMIT_ACK_TIMEOUT_MS=5000
IBKR_CANCEL_ACK_TIMEOUT_MS=5000
# IBKR ordinary stock orders do not have a native atomic reduce-only flag. Live
# execution stays fail-closed unless the explicit software guard is enabled.
IBKR_ALLOW_SOFTWARE_REDUCE_ONLY=false

# IB Gateway container. Paper listens on API port 4002; live normally uses 4001.
# A live execution deployment must set IBKR_READ_ONLY_API=no.
IBKR_TWS_USERID=
IBKR_TWS_USERID_FILE=
IBKR_TWS_PASSWORD=
IBKR_TWS_PASSWORD_FILE=
IBKR_TRADING_MODE=paper
IBKR_GATEWAY_API_PORT=4002
IBKR_GATEWAY_PORT=4002
IBKR_READ_ONLY_API=yes

# Binance Portfolio Margin remains fail-closed in the real runtime until its
# execution/recovery parity slice is completed.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# Telegram control plane
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_REFRESH_COOLDOWN_SECONDS=15
TELEGRAM_EMERGENCY_COOLDOWN_SECONDS=60
