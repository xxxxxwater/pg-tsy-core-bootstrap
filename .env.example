PG_ENV=dev
PG_INSTANCE_ID=local-dev-1
PG_RUN_MODE=shadow
PG_LIVE_TRADING=false
PG_SHUTDOWN_POLICY=cancel_resting
PG_DATABASE_URL=postgresql://pgtsy:pgtsy@localhost:5432/pgtsy
PG_DATA_ROOT=./data
PG_SIGNAL_TTL_MS=5000
PG_MAX_MARKET_STALENESS_MS=3000
PG_LEASE_TTL_SECONDS=15
RUST_LOG=info

# Never commit real credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
HYPERLIQUID_PRIVATE_KEY=
IBKR_GATEWAY_ADDR=127.0.0.1:4002
IBKR_CLIENT_ID=17
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
